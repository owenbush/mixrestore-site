---
import { Image } from 'astro:assets';
import logoIcon from '../assets/logo-icon.png';
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo-link">
      <Image src={logoIcon} alt="" width={28} height={28} />
      <span class="logo-text">MixRestore</span>
    </a>
    <button class="nav-toggle" data-nav-toggle aria-expanded="false" aria-label="Toggle navigation">
      <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <nav data-nav>
      <a href="/#features">Features</a>
      <a href="/docs">Docs</a>
      <a href="/download">Download</a>
      <a href="https://mixrestore.lemonsqueezy.com/checkout/buy/882ed3c3-f9b8-4841-af50-e7138e18af98?desc=0" class="btn-download">Buy</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(14, 16, 20, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .logo-link img {
    width: 28px;
    height: 28px;
    border-radius: 6px;
  }

  .logo-text {
    font-size: 1rem;
    font-weight: 600;
    color: #ecedf0;
    letter-spacing: -0.02em;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--text-mid);
    cursor: pointer;
    padding: 0.25rem;
  }

  .nav-toggle .icon-close {
    display: none;
  }

  .nav-toggle.open .icon-menu {
    display: none;
  }

  .nav-toggle.open .icon-close {
    display: block;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  nav a {
    color: var(--text-dim);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.12s;
  }

  nav a:hover {
    color: var(--text);
    opacity: 1;
  }

  nav a.btn-download {
    background: var(--accent);
    color: #111;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.8rem;
  }

  nav a.btn-download:hover {
    color: #111;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: block;
    }

    nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 0.75rem;
      margin-top: 0.75rem;
      border-top: 1px solid var(--line);
    }

    nav.open {
      display: flex;
    }

    nav a {
      padding: 0.6rem 0;
      font-size: 0.925rem;
    }

    nav a.btn-download {
      text-align: center;
      margin-top: 0.5rem;
      padding: 0.6rem 1rem;
    }
  }
</style>
