---
import { Image } from 'astro:assets';
import logoIcon from '../assets/logo-icon.png';
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo-link">
      <Image src={logoIcon} alt="" width={28} height={28} />
      <span class="logo-text">MixRestore</span>
    </a>
    <nav>
      <a href="/#features">Features</a>
      <a href="/docs">Docs</a>
      <a href="https://mixrestore.lemonsqueezy.com/checkout/buy/882ed3c3-f9b8-4841-af50-e7138e18af98?desc=0" class="btn-download">Buy</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(14, 16, 20, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .logo-link img {
    width: 28px;
    height: 28px;
    border-radius: 6px;
  }

  .logo-text {
    font-size: 1rem;
    font-weight: 600;
    color: #ecedf0;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  nav a {
    color: var(--text-dim);
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.12s;
  }

  nav a:hover {
    color: var(--text);
    opacity: 1;
  }

  nav a.btn-download {
    background: var(--accent);
    color: #111;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.8rem;
  }

  nav a.btn-download:hover {
    color: #111;
    opacity: 0.9;
  }
</style>
