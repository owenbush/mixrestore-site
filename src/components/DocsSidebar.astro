---
const sections = [
  {
    title: 'Getting Started',
    links: [
      { href: '/docs', label: 'Introduction' },
      { href: '/docs/installation', label: 'Installation' },
      { href: '/docs/quick-start', label: 'Quick Start' },
    ],
  },
  {
    title: 'Features',
    links: [
      { href: '/docs/auto-versioning', label: 'Auto Versioning' },
      { href: '/docs/version-tags', label: 'Version Tags' },
      { href: '/docs/restore', label: 'Restoring Versions' },
      { href: '/docs/project-insights', label: 'Project Insights' },
    ],
  },
  {
    title: 'Reference',
    links: [
      { href: '/docs/supported-daws', label: 'Supported DAWs' },
      { href: '/docs/settings', label: 'Settings' },
      { href: '/docs/how-it-works', label: 'How It Works' },
    ],
  },
];

const currentPath = Astro.url.pathname;
---

<aside class="docs-sidebar" data-sidebar>
  <button class="sidebar-toggle" data-sidebar-toggle aria-expanded="false" aria-controls="sidebar-nav">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
    <span>Documentation menu</span>
  </button>
  <div class="sidebar-nav" id="sidebar-nav" data-sidebar-nav>
    {sections.map((section) => (
      <div class="sidebar-section">
        <h4>{section.title}</h4>
        <ul>
          {section.links.map((link) => (
            <li>
              <a href={link.href} class:list={[{ active: currentPath === link.href }]}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</aside>

<script>
  const toggle = document.querySelector('[data-sidebar-toggle]');
  const nav = document.querySelector('[data-sidebar-nav]');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>

<style>
  .docs-sidebar {
    position: sticky;
    top: 5rem;
    align-self: start;
  }

  .sidebar-toggle {
    display: none;
  }

  .sidebar-section {
    margin-bottom: 1.5rem;
  }

  .sidebar-section h4 {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  li a {
    display: block;
    padding: 0.3rem 0.65rem;
    font-size: 0.825rem;
    color: var(--text-dim);
    border-radius: 4px;
    transition: all 0.1s;
  }

  li a:hover {
    color: var(--text);
    background: var(--bg-2);
    opacity: 1;
  }

  li a.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  @media (max-width: 768px) {
    .docs-sidebar {
      position: relative;
      top: 0;
    }

    .sidebar-toggle {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
      padding: 0.65rem 0.75rem;
      background: var(--bg-2);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      color: var(--text-mid);
      font-family: var(--font);
      font-size: 0.825rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.12s;
    }

    .sidebar-toggle:hover {
      background: var(--bg-3);
    }

    .sidebar-nav {
      display: none;
      padding: 1rem 0.25rem;
    }

    .sidebar-nav.open {
      display: block;
    }
  }
</style>
